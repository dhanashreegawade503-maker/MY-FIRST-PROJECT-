<script>
// NAVBAR SCROLL
window.addEventListener('scroll',()=>{ document.getElementById('navbar').classList.toggle('scrolled',window.scrollY>40); });
function closeMob(){ document.getElementById('mob').classList.remove('open'); }

// REVEAL
const ro=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('in');});},{threshold:0.08});
document.querySelectorAll('.reveal,.reveal-l,.reveal-r').forEach(el=>ro.observe(el));

// COUNTDOWN — December 20, 2025
(function(){
  const t=new Date('2025-12-20T09:00:00');
  function u(){
    const diff=t-new Date();
    if(diff<=0){['cd-d','cd-h','cd-m','cd-s'].forEach(id=>document.getElementById(id).textContent='00');return;}
    const pad=n=>String(n).padStart(2,'0');
    document.getElementById('cd-d').textContent=pad(Math.floor(diff/864e5));
    document.getElementById('cd-h').textContent=pad(Math.floor((diff%864e5)/36e5));
    document.getElementById('cd-m').textContent=pad(Math.floor((diff%36e5)/6e4));
    document.getElementById('cd-s').textContent=pad(Math.floor((diff%6e4)/1e3));
  }
  u(); setInterval(u,1000);
})();

// FAQ
function toggleF(btn){
  const b=btn.nextElementSibling, ic=btn.querySelector('.faq-icon'), open=b.classList.contains('open');
  document.querySelectorAll('.faq-body.open').forEach(x=>{x.classList.remove('open');x.previousElementSibling.querySelector('.faq-icon').classList.remove('open');});
  if(!open){b.classList.add('open');ic.classList.add('open');}
}

// BOARD GAME FLIP
let cardFlipped = false;
function flipGame(){
  const inner = document.getElementById('flipInner');
  cardFlipped = !cardFlipped;
  inner.classList.remove('flipped','unflipped');
  inner.classList.add(cardFlipped ? 'flipped' : 'unflipped');
}

// ORDER MODAL
function openOrder(name){
  document.getElementById('modal-title').textContent='Pre-Order: '+name;
  document.getElementById('modal-wa').href='https://wa.me/918928703606?text='+encodeURIComponent('Hi! I want to pre-order '+name+'. Coupon code: MATH20');
  document.getElementById('order-modal').style.display='flex';
}
document.getElementById('order-modal').addEventListener('click',function(e){if(e.target===this)this.style.display='none';});

// STARS
document.querySelectorAll('.star').forEach(s=>{
  s.addEventListener('click',()=>{
    const v=parseInt(s.dataset.v); document.getElementById('sv').value=v;
    document.querySelectorAll('.star').forEach((x,i)=>x.classList.toggle('lit',i<v));
  });
  s.addEventListener('mouseenter',()=>{ const v=parseInt(s.dataset.v); document.querySelectorAll('.star').forEach((x,i)=>x.style.color=i<v?'#f59e0b':''); });
  s.addEventListener('mouseleave',()=>{ const c=parseInt(document.getElementById('sv').value); document.querySelectorAll('.star').forEach((x,i)=>x.style.color=i<c?'#f59e0b':''); });
});

// POST REVIEW
// REVIEWS — persisted via localStorage, only 3★ and above are shown publicly
const REVIEW_KEY = 'mathlab_reviews_v1';
const pals=[{bg:'#dbeafe',c:'#1d4ed8'},{bg:'#d1fae5',c:'#065f46'},{bg:'#ede9fe',c:'#5b21b6'},{bg:'#fef3c7',c:'#92400e'}];

function loadReviews(){
  try{
    const raw = localStorage.getItem(REVIEW_KEY);
    return raw ? JSON.parse(raw) : [];
  }catch(e){ return []; }
}
function saveReviews(list){
  try{ localStorage.setItem(REVIEW_KEY, JSON.stringify(list)); }catch(e){}
}
function renderReviewCard(rev, idx){
  const init=rev.name.split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase();
  const pal=pals[idx%pals.length];
  const stars='★'.repeat(rev.stars)+'☆'.repeat(5-rev.stars);
  const card=document.createElement('div');
  card.className='tcard';
  card.innerHTML='<div style="color:#f59e0b;font-size:1.1rem;margin-bottom:10px;">'+stars+'</div><p style="color:#475569;font-size:0.88rem;line-height:1.65;margin-bottom:14px;">"'+rev.text+'"</p><div style="display:flex;align-items:center;gap:10px;"><div style="width:38px;height:38px;border-radius:50%;background:'+pal.bg+';display:flex;align-items:center;justify-content:center;font-weight:800;font-size:0.9rem;color:'+pal.c+';flex-shrink:0;">'+init+'</div><div><div style="font-family:Nunito,sans-serif;font-weight:800;font-size:0.9rem;color:#1a2980;">'+rev.name+'</div><div style="color:#94a3b8;font-size:0.75rem;">'+(rev.role||'Community Member')+'</div></div></div>';
  return card;
}
function renderAllReviews(){
  const container = document.getElementById('dyn-rev');
  const noRevMsg = document.getElementById('no-rev-msg');
  container.innerHTML='';
  const all = loadReviews();
  const visible = all.filter(r=>r.stars>=3); // only 3 stars and above are shown publicly
  if(visible.length===0){
    noRevMsg.style.display='block';
  } else {
    noRevMsg.style.display='none';
    visible.slice().reverse().forEach((rev,idx)=>container.appendChild(renderReviewCard(rev,idx)));
  }
}
function postRev(){
  const n=document.getElementById('rv-n').value.trim();
  const r=document.getElementById('rv-r').value.trim();
  const t=document.getElementById('rv-t').value.trim();
  const s=parseInt(document.getElementById('sv').value);
  const msg=document.getElementById('rvmsg');
  if(!n||!t||!s){msg.textContent='⚠️ Please fill name, review and rating.';msg.style.background='#fef2f2';msg.style.color='#b91c1c';msg.style.display='block';return;}

  const all = loadReviews();
  all.push({ name:n, role:r, text:t, stars:s, ts:Date.now() });
  saveReviews(all);
  renderAllReviews();

  ['rv-n','rv-r','rv-t'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('sv').value='0';
  document.querySelectorAll('.star').forEach(x=>{x.classList.remove('lit');x.style.color='';});

  if(s>=3){
    msg.textContent='✅ Review posted! Thank you!';msg.style.background='#f0fdf4';msg.style.color='#15803d';
  } else {
    msg.textContent='Thank you for your feedback — we\'ll use it to improve!';msg.style.background='#fffbeb';msg.style.color='#92400e';
  }
  msg.style.display='block';
  setTimeout(()=>msg.style.display='none',4000);
}
document.addEventListener('DOMContentLoaded', renderAllReviews);
document.addEventListener('keydown', function(e){
  if(e.key === 'Escape') closeAlbum();
});

// GALLERY DATA (photos live here; editable via Admin Mode)
let galleryData = { "album-june": [], "album-felicitation": [] };
try {
  const raw = document.getElementById('gallery-data-json');
  if(raw) galleryData = JSON.parse(raw.textContent);
} catch(e){ console.error('Gallery data failed to parse', e); }

let isAdmin = false;
let currentAlbumId = null;
const ADMIN_PASSWORD = 'MathLab19';

function updateFolderCounts(){
  Object.keys(galleryData).forEach(function(id){
    const el = document.getElementById('count-' + id);
    if(el) el.textContent = galleryData[id].length + ' Photos';
  });
}

// GALLERY FOLDERS → ALBUM MODAL
const albumInfo = {
  'album-june': { title:'📸 Maths Carnival 2026 — June', sub:'Relive the moments from our latest carnival — tap any photo to view it full size.' },
  'album-felicitation': { title:'📸 Carnival Felicitation & Games Moments', sub:'More memories from the celebration — tap any photo to view it full size.' }
};

function renderAlbum(id){
  const grid = document.getElementById(id);
  if(!grid) return;
  grid.innerHTML = '';
  const items = galleryData[id] || [];
  items.forEach(function(item, idx){
    const div = document.createElement('div');
    div.className = 'gal-item';
    div.style.cssText = 'height:220px;cursor:zoom-in;position:relative;';
    const img = document.createElement('img');
    img.src = item.src;
    img.alt = item.alt || 'Gallery photo';
    img.style.cssText = 'width:100%;height:100%;object-fit:cover;border-radius:16px;';
    img.onclick = function(e){ e.stopPropagation(); openLightbox(item.src); };
    div.appendChild(img);
    if(isAdmin){
      const delBtn = document.createElement('button');
      delBtn.className = 'gal-del-btn';
      delBtn.type = 'button';
      delBtn.innerHTML = '✕';
      delBtn.onclick = function(e){ e.stopPropagation(); deleteImage(id, idx); };
      div.appendChild(delBtn);
    }
    grid.appendChild(div);
  });
  if(isAdmin){
    const addTile = document.createElement('div');
    addTile.className = 'gal-add-tile';
    addTile.onclick = function(){ document.getElementById('file-input-' + id).click(); };
    addTile.innerHTML = '<span style="font-size:2.2rem;line-height:1;">+</span><span style="font-size:0.8rem;font-weight:800;">Add Photos</span>';
    grid.appendChild(addTile);

    const fileInput = document.createElement('input');
    fileInput.type = 'file';
    fileInput.accept = 'image/*';
    fileInput.multiple = true;
    fileInput.id = 'file-input-' + id;
    fileInput.style.display = 'none';
    fileInput.onchange = function(e){ handleFileUpload(id, e.target.files); e.target.value=''; };
    grid.appendChild(fileInput);
  }
  updateFolderCounts();
}

function deleteImage(albumId, idx){
  if(!confirm('Remove this photo from the gallery?')) return;
  galleryData[albumId].splice(idx, 1);
  renderAlbum(albumId);
}

function handleFileUpload(albumId, files){
  const arr = Array.from(files);
  if(arr.length === 0) return;
  let remaining = arr.length;
  arr.forEach(function(file){
    const reader = new FileReader();
    reader.onload = function(e){
      const img = new Image();
      img.onload = function(){
        const targetW = Math.min(700, img.width);
        const scale = targetW / img.width;
        const targetH = Math.round(img.height * scale);
        const canvas = document.createElement('canvas');
        canvas.width = targetW;
        canvas.height = targetH;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, targetW, targetH);
        const dataUrl = canvas.toDataURL('image/jpeg', 0.82);
        galleryData[albumId].push({ src: dataUrl, alt: 'Gallery photo' });
        remaining--;
        if(remaining === 0) renderAlbum(albumId);
      };
      img.onerror = function(){ remaining--; if(remaining===0) renderAlbum(albumId); };
      img.src = e.target.result;
    };
    reader.onerror = function(){ remaining--; if(remaining===0) renderAlbum(albumId); };
    reader.readAsDataURL(file);
  });
}

function openAlbum(id){
  document.querySelectorAll('.album-grid').forEach(g=>g.style.display='none');
  currentAlbumId = id;
  renderAlbum(id);
  const grid = document.getElementById(id);
  if(grid) grid.style.display='grid';
  const info = albumInfo[id];
  if(info){
    document.getElementById('album-modal-title').textContent = info.title;
    document.getElementById('album-modal-sub').textContent = info.sub;
  }
  document.getElementById('album-overlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeAlbum(){
  document.getElementById('album-overlay').classList.remove('open');
  document.body.style.overflow = '';
}

// ADMIN MODE / PASSWORD PROTECTION
function openPasswordModal(){
  document.getElementById('pw-input').value = '';
  document.getElementById('pw-error').classList.remove('show');
  document.getElementById('pw-overlay').classList.add('open');
  setTimeout(function(){
    const el = document.getElementById('pw-input');
    if(el) el.focus();
  }, 100);
}
function closePasswordModal(){
  document.getElementById('pw-overlay').classList.remove('open');
}
function submitPassword(){
  const val = document.getElementById('pw-input').value;
  if(val === ADMIN_PASSWORD){
    isAdmin = true;
    closePasswordModal();
    document.getElementById('admin-bar').classList.add('visible');
    if(currentAlbumId) renderAlbum(currentAlbumId);
  } else {
    document.getElementById('pw-error').classList.add('show');
  }
}
function exitAdminMode(){
  isAdmin = false;
  document.getElementById('admin-bar').classList.remove('visible');
  if(currentAlbumId) renderAlbum(currentAlbumId);
}

// DOWNLOAD UPDATED SITE (with current gallery data baked in)
function downloadUpdatedSite(){
  const dataScript = document.getElementById('gallery-data-json');
  if(dataScript) dataScript.textContent = JSON.stringify(galleryData);

  const htmlClone = document.documentElement.cloneNode(true);

  const overlay = htmlClone.querySelector('#album-overlay');
  if(overlay) overlay.classList.remove('open');
  const pwOverlay = htmlClone.querySelector('#pw-overlay');
  if(pwOverlay) pwOverlay.classList.remove('open');
  const adminBarClone = htmlClone.querySelector('#admin-bar');
  if(adminBarClone) adminBarClone.classList.remove('visible');
  const pwInputClone = htmlClone.querySelector('#pw-input');
  if(pwInputClone) pwInputClone.value = '';
  ['album-june','album-felicitation'].forEach(function(id){
    const g = htmlClone.querySelector('#' + id);
    if(g){ g.innerHTML=''; g.setAttribute('style','display:none;'); }
  });
  document.body.style.overflow = document.body.style.overflow; // no-op, keep live page state

  const htmlStr = '<!DOCTYPE html>\n' + htmlClone.outerHTML;
  const blob = new Blob([htmlStr], { type:'text/html' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'mathematics-lab.html';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

document.addEventListener('DOMContentLoaded', updateFolderCounts);

// CARNIVAL GALLERY LIGHTBOX
function openLightbox(src){
  let box = document.getElementById('lightbox-overlay');
  if(!box){
    box = document.createElement('div');
    box.id = 'lightbox-overlay';
    box.style.cssText = 'display:none;position:fixed;inset:0;z-index:3000;background:rgba(0,0,0,0.85);align-items:center;justify-content:center;padding:24px;cursor:zoom-out;';
    box.innerHTML = '<img id="lightbox-img" style="max-width:92vw;max-height:88vh;border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,0.5);" src=""/>';
    box.onclick = ()=>{ box.style.display='none'; };
    document.body.appendChild(box);
  }
  document.getElementById('lightbox-img').src = src;
  box.style.display = 'flex';
}

// ENQUIRY → WHATSAPP
function submitEnq(){
  const s=document.getElementById('eq-s').value.trim();
  const p=document.getElementById('eq-p').value.trim();
  const m=document.getElementById('eq-m').value.trim();
  const e=document.getElementById('eq-e').value.trim();
  const g=document.getElementById('eq-g').value;
  const msg=document.getElementById('eqmsg');
  function showErr(t){msg.textContent=t;msg.style.background='#fef2f2';msg.style.color='#b91c1c';msg.style.display='block';}
  if(!s||!p||!m||!e||!g){showErr('⚠️ Please fill all required fields.');return;}
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e)){showErr('⚠️ Please enter a valid email address.');return;}
  if(!/^[0-9]{10}$/.test(m)){showErr('⚠️ Please enter a valid 10-digit mobile number.');return;}
  const wa='https://wa.me/918928703606?text='+encodeURIComponent("Hi Mathematic's Laβ!\nStudent: "+s+"\nParent: "+p+"\nMobile: "+m+"\nEmail: "+e+"\nStandard: "+g);
  window.open(wa,'_blank');
  msg.textContent="✅ Opening WhatsApp with your details!";msg.style.background='#f0fdf4';msg.style.color='#15803d';msg.style.display='block';
}

// MINI GAME
const Qs=[
  {c:'Addition',q:'8 + 7 = ?',a:'15',o:['12','14','15','17']},
  {c:'Addition',q:'23 + 45 = ?',a:'68',o:['58','68','78','73']},
  {c:'Addition',q:'99 + 11 = ?',a:'110',o:['100','108','110','121']},
  {c:'Addition',q:'17 + 26 = ?',a:'43',o:['33','43','53','41']},
  {c:'Addition',q:'56 + 38 = ?',a:'94',o:['84','92','94','96']},
  {c:'Subtraction',q:'50 − 18 = ?',a:'32',o:['28','30','32','36']},
  {c:'Subtraction',q:'100 − 37 = ?',a:'63',o:['53','63','67','73']},
  {c:'Subtraction',q:'75 − 29 = ?',a:'46',o:['44','46','56','36']},
  {c:'Subtraction',q:'200 − 88 = ?',a:'112',o:['102','108','112','122']},
  {c:'Subtraction',q:'63 − 27 = ?',a:'36',o:['26','34','36','46']},
  {c:'Multiplication',q:'6 × 7 = ?',a:'42',o:['36','42','48','54']},
  {c:'Multiplication',q:'8 × 9 = ?',a:'72',o:['62','70','72','81']},
  {c:'Multiplication',q:'12 × 5 = ?',a:'60',o:['55','58','60','65']},
  {c:'Multiplication',q:'7 × 7 = ?',a:'49',o:['42','47','49','56']},
  {c:'Multiplication',q:'11 × 8 = ?',a:'88',o:['78','82','86','88']},
  {c:'Division',q:'48 ÷ 6 = ?',a:'8',o:['6','7','8','9']},
  {c:'Division',q:'81 ÷ 9 = ?',a:'9',o:['7','8','9','10']},
  {c:'Division',q:'72 ÷ 8 = ?',a:'9',o:['6','8','9','12']},
  {c:'Division',q:'56 ÷ 7 = ?',a:'8',o:['7','8','9','6']},
  {c:'Division',q:'100 ÷ 4 = ?',a:'25',o:['20','24','25','30']},
  {c:'Pattern',q:'2, 4, 6, 8, __',a:'10',o:['9','10','11','12']},
  {c:'Pattern',q:'5, 10, 15, 20, __',a:'25',o:['24','25','26','30']},
  {c:'Pattern',q:'3, 6, 12, 24, __',a:'48',o:['36','42','48','60']},
  {c:'Pattern',q:'100, 90, 80, 70, __',a:'60',o:['50','60','65','75']},
  {c:'Mixed',q:'(4 + 5) × 3 = ?',a:'27',o:['22','24','27','30']},
];
let qi=0,sc=0,ans=false;
function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}}
function startG(){
  qi=0;sc=0;ans=false;shuffle(Qs);
  document.getElementById('gs').style.display='none';
  document.getElementById('gr').style.display='none';
  document.getElementById('gp').style.display='block';
  renderQ();
}
function renderQ(){
  ans=false;
  const q=Qs[qi];
  document.getElementById('qcnt').textContent='Question '+(qi+1)+' of '+Qs.length;
  document.getElementById('scdsp').textContent='Score: '+sc;
  document.getElementById('pgbar').style.width=(qi/Qs.length*100)+'%';
  document.getElementById('qcat').textContent='🔢 '+q.c;
  document.getElementById('qtxt').textContent=q.q;
  document.getElementById('qfb').style.display='none';
  document.getElementById('nxtb').style.display='none';
  const cg=document.getElementById('cg');cg.innerHTML='';
  [...q.o].sort(()=>Math.random()-.5).forEach(opt=>{
    const b=document.createElement('button');b.className='choice';b.textContent=opt;
    b.onclick=()=>ansQ(b,opt,q.a);cg.appendChild(b);
  });
}
function ansQ(btn,chosen,correct){
  if(ans)return;ans=true;
  document.querySelectorAll('.choice').forEach(b=>b.disabled=true);
  const fb=document.getElementById('qfb');
  if(chosen===correct){btn.classList.add('correct');sc++;fb.textContent='✅ Correct! Well done!';fb.style.background='#f0fdf4';fb.style.color='#15803d';}
  else{btn.classList.add('wrong');document.querySelectorAll('.choice').forEach(b=>{if(b.textContent===correct)b.classList.add('correct');});fb.textContent='❌ Answer: '+correct;fb.style.background='#fef2f2';fb.style.color='#b91c1c';}
  fb.style.display='block';
  document.getElementById('scdsp').textContent='Score: '+sc;
  document.getElementById('nxtb').style.display='inline-block';
}
function nxtQ(){qi++;if(qi>=Qs.length)showResult();else renderQ();}
function showResult(){
  document.getElementById('gp').style.display='none';
  document.getElementById('gr').style.display='block';
  document.getElementById('pgbar').style.width='100%';
  const pct=Math.round(sc/Qs.length*100);
  let em,ti,mg;
  if(pct>=90){em='🏆';ti='Outstanding!';mg='You\'re a Math Champion! Incredible score!';}
  else if(pct>=70){em='🌟';ti='Great Job!';mg='Well played! A little more practice and you\'ll ace it!';}
  else if(pct>=50){em='👍';ti='Good Effort!';mg='Solid work! Keep practising and you\'ll improve fast.';}
  else{em='💪';ti='Keep Going!';mg='Practice makes perfect — try again!';}
  document.getElementById('rem').textContent=em;
  document.getElementById('rtitle').textContent=ti;
  document.getElementById('rsc').textContent='You scored '+sc+' out of '+Qs.length+' ('+pct+'%)';
  document.getElementById('rmsg').textContent=mg;
}
</script>



</body></html>
