    </div>
    <div class="card reveal in" id="game-wrap" style="padding:40px;background:#fff;">
      <!-- Start -->
      <div id="gs" style="text-align:center;">
        <div style="font-size:5rem;margin-bottom:16px;">🧮</div>
        <h3 style="font-family:'Nunito',sans-serif;font-weight:900;font-size:1.6rem;color:#1a2980;margin-bottom:10px;">Ready to Play?</h3>
        <p style="color:#64748b;font-size:0.9rem;margin-bottom:28px;">Answer 25 math questions — addition, subtraction, multiplication, division &amp; patterns. No time limit, just fun!</p>
        <button onclick="startG()" class="btn-blue" style="font-size:1rem;padding:1rem 3rem;">Start the Game 🚀</button>
      </div>
      <!-- Game -->
      <div id="gp" style="display:none;">
        <div style="display:flex;justify-content:space-between;margin-bottom:6px;">
          <span id="qcnt" style="font-family:'Nunito',sans-serif;font-weight:700;color:#64748b;font-size:0.88rem;">Q 1/25</span>
          <span id="scdsp" style="font-family:'Nunito',sans-serif;font-weight:800;color:#1a2980;">Score: 0</span>
        </div>
        <div style="width:100%;background:#e2e8f0;border-radius:999px;height:8px;margin-bottom:24px;overflow:hidden;">
          <div class="prog-fill" id="pgbar" style="height:100%;border-radius:999px;width:4%;"></div>
        </div>
        <div style="text-align:center;margin-bottom:28px;">
          <div id="qcat" style="font-size:0.7rem;font-weight:800;letter-spacing:0.2em;text-transform:uppercase;color:#0ea5e9;margin-bottom:10px;"></div>
          <div id="qtxt" style="font-family:'Nunito',sans-serif;font-weight:900;font-size:2.2rem;color:#1a2980;min-height:3rem;"></div>
        </div>
        <div id="cg" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;"></div>
        <div id="qfb" style="display:none;text-align:center;margin-top:16px;padding:12px;border-radius:12px;font-family:'Nunito',sans-serif;font-weight:700;font-size:0.95rem;"></div>
        <div style="display:flex;justify-content:flex-end;margin-top:16px;">
          <button id="nxtb" onclick="nxtQ()" style="display:none;" class="btn-blue">Next →</button>
        </div>
      </div>
      <!-- Result -->
