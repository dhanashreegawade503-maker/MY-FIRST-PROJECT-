        <div id="rem" style="font-size:5rem;margin-bottom:14px;">🎉</div>
        <h3 id="rtitle" style="font-family:'Nunito',sans-serif;font-weight:900;font-size:2rem;color:#1a2980;margin-bottom:8px;"></h3>
        <p id="rsc" style="color:#475569;font-weight:600;margin-bottom:8px;"></p>
        <p id="rmsg" style="color:#94a3b8;font-size:0.9rem;margin-bottom:28px;"></p>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
          <button onclick="startG()" class="btn-blue">Play Again 🔄</button>
