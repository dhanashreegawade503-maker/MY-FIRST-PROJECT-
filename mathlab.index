<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="google-site-verification" content="rtTBkf991Q6FtppWFcNXWoLI_Upr5cmgL7_8-XSgjZ0">
<title>Mathematic's Laβ – Explore Infinite World of Mathematics</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&amp;family=Nunito:wght@400;600;700;800;900&amp;family=Poppins:wght@300;400;500;600&amp;display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<style>
* { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; }
body { font-family:'Poppins',sans-serif; background:#ffffff; color:#1e293b; overflow-x:hidden; }

.logo-font { font-family:'Caveat',cursive; font-weight:700; }

/* NAVBAR */
#navbar {
  position:fixed; top:0; left:0; right:0; z-index:1000;
  background:rgba(255,255,255,0.98);
  backdrop-filter:blur(20px);
  border-bottom:2px solid #e8f0fe;
  transition:box-shadow 0.3s;
}
#navbar.scrolled { box-shadow: 0 4px 30px rgba(26,41,128,0.12); }
.nav-link {
  position:relative; font-family:'Nunito',sans-serif; font-weight:700;
  font-size:0.83rem; color:#1a2980; padding:4px 2px;
  transition:color 0.2s; text-decoration:none;
}
.nav-link::after {
  content:''; position:absolute; bottom:-3px; left:0; width:0; height:2.5px;
  background:linear-gradient(90deg,#1a2980,#0ea5e9);
  border-radius:2px; transition:width 0.3s;
}
.nav-link:hover { color:#0ea5e9; }
.nav-link:hover::after { width:100%; }

/* BUTTONS */
.btn-blue {
  background:linear-gradient(135deg,#1a2980,#0ea5e9);
  color:#fff; font-family:'Nunito',sans-serif; font-weight:800;
  border-radius:50px; padding:0.85rem 2.2rem;
  display:inline-block; transition:transform 0.2s, box-shadow 0.2s;
  box-shadow:0 4px 20px rgba(14,165,233,0.35);
  text-decoration:none; border:none; cursor:pointer; font-size:0.95rem;
}
.btn-blue:hover { transform:translateY(-3px); box-shadow:0 8px 28px rgba(14,165,233,0.5); }

.btn-green {
  background:linear-gradient(135deg,#16a34a,#22c55e);
  color:#fff; font-family:'Nunito',sans-serif; font-weight:800;
  border-radius:50px; padding:0.85rem 2.2rem;
  display:inline-block; transition:transform 0.2s, box-shadow 0.2s;
  box-shadow:0 4px 20px rgba(34,197,94,0.3);
  text-decoration:none; border:none; cursor:pointer; font-size:0.95rem;
}
.btn-green:hover { transform:translateY(-3px); box-shadow:0 8px 28px rgba(34,197,94,0.45); }

.btn-outline {
  border:2.5px solid #1a2980; color:#1a2980;
  font-family:'Nunito',sans-serif; font-weight:700;
  border-radius:50px; padding:0.8rem 2rem;
  display:inline-block; transition:all 0.2s;
  text-decoration:none; background:transparent; cursor:pointer; font-size:0.9rem;
}
.btn-outline:hover { background:#1a2980; color:#fff; transform:translateY(-2px); }

/* 3D CARDS */
.card {
  background:#fff; border-radius:20px;
  border:1.5px solid #e8f0fe;
  box-shadow: 0 4px 6px rgba(26,41,128,0.04), 0 10px 20px rgba(26,41,128,0.07), 0 30px 50px rgba(26,41,128,0.06);
  transition:transform 0.3s cubic-bezier(.34,1.56,.64,1), box-shadow 0.3s;
}
.card:hover {
  transform:translateY(-10px) scale(1.02);
  box-shadow: 0 8px 12px rgba(26,41,128,0.07), 0 20px 40px rgba(26,41,128,0.12), 0 50px 80px rgba(26,41,128,0.10);
}

/* HERO */
.hero {
  background:linear-gradient(135deg,#1a2980 0%,#1565c0 45%,#0ea5e9 100%);
  position:relative; overflow:hidden;
}
.hero-wave { position:absolute; bottom:-1px; left:0; right:0; }

/* SECTION LABELS */
.eyebrow {
  font-family:'Nunito',sans-serif; font-size:0.72rem; font-weight:800;
  letter-spacing:0.22em; text-transform:uppercase; color:#0ea5e9;
}
.sec-title { font-family:'Nunito',sans-serif; font-weight:900; color:#1a2980; line-height:1.2; }
.sec-title span { color:#0ea5e9; }

/* BLUE BG SECTION */
.bg-navy { background:linear-gradient(135deg,#1a2980,#0369a1); }
.bg-light { background:#f0f7ff; }

/* COUNTDOWN */
.cd-box {
  background:#fff; border-radius:16px;
  border:2px solid #bfdbfe; padding:1.2rem 1rem;
  min-width:80px; text-align:center;
  box-shadow:0 4px 20px rgba(14,165,233,0.12);
}
.cd-num { font-family:'Nunito',sans-serif; font-weight:900; font-size:2.5rem; color:#1a2980; line-height:1; }
.cd-label { font-size:0.62rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#94a3b8; margin-top:4px; }

/* FAQ */
.faq-body { max-height:0; overflow:hidden; transition:max-height 0.4s ease; }
.faq-body.open { max-height:260px; }
.faq-icon { transition:transform 0.3s; display:inline-block; color:#0ea5e9; font-size:1.5rem; font-weight:300; }
.faq-icon.open { transform:rotate(45deg); }
.faq-item {
  background:#fff; border-radius:16px;
  border:1.5px solid #e8f0fe;
  overflow:hidden; margin-bottom:12px;
  box-shadow:0 2px 10px rgba(26,41,128,0.05);
  transition:border-color 0.2s;
}
.faq-item:hover { border-color:#93c5fd; }

/* GAME */
.prog-fill { background:linear-gradient(90deg,#1a2980,#0ea5e9); transition:width 0.5s ease; }
.choice {
  background:#fff; border:2.5px solid #e2e8f0;
  border-radius:14px; padding:0.95rem 1.2rem;
  width:100%; cursor:pointer;
  font-family:'Nunito',sans-serif; font-size:1rem; font-weight:700; color:#1e293b;
  transition:all 0.2s; text-align:left;
  box-shadow:0 2px 6px rgba(0,0,0,0.04);
}
.choice:hover:not(:disabled) { border-color:#0ea5e9; background:#eff6ff; transform:translateY(-2px); box-shadow:0 4px 14px rgba(14,165,233,0.15); }
.choice.correct { border-color:#16a34a; background:#f0fdf4; color:#15803d; }
.choice.wrong   { border-color:#dc2626; background:#fef2f2; color:#b91c1c; }
.choice:disabled { cursor:default; transform:none; }

/* STARS */
.star { cursor:pointer; font-size:1.6rem; color:#d1d5db; transition:color 0.15s; user-select:none; }
.star.lit { color:#f59e0b; }

/* FORM */
.field {
  width:100%; background:#fff; border:1.5px solid #e2e8f0;
  border-radius:12px; padding:0.75rem 1rem;
  font-family:'Poppins',sans-serif; font-size:0.88rem; color:#1e293b;
  transition:border-color 0.2s, box-shadow 0.2s; outline:none;
}
.field:focus { border-color:#0ea5e9; box-shadow:0 0 0 3px rgba(14,165,233,0.12); }
.field::placeholder { color:#94a3b8; }

/* FLOATING BUTTONS */
.float-wrap { position:fixed; bottom:24px; right:20px; z-index:9999; display:flex; flex-direction:column; gap:10px; align-items:center; }
.float-btn {
  width:54px; height:54px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  border:none; cursor:pointer; transition:transform 0.2s, box-shadow 0.2s;
  box-shadow:0 4px 18px rgba(0,0,0,0.22);
}
.float-btn:hover { transform:scale(1.13); }
.float-wa { background:#25D366; }
.float-call { background:#1a2980; }

/* TESTIMONIAL */
.tcard {
  background:#fff; border-radius:20px;
  border:1.5px solid #e8f0fe; padding:1.6rem;
  box-shadow:0 4px 18px rgba(26,41,128,0.07);
  transition:transform 0.3s, box-shadow 0.3s;
}
.tcard:hover { transform:translateY(-5px); box-shadow:0 12px 36px rgba(26,41,128,0.12); }

/* 3D FLIP PRODUCT CARD */
.product-3d-wrap { perspective: 1600px; }
.product-card-3d {
  width: 100%;
  aspect-ratio: 4/5;
  cursor: pointer;
  position: relative;
}
.flip-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform 0.9s cubic-bezier(.4,.2,.2,1);
  transform-style: preserve-3d;
  animation: autoRotate 7s ease-in-out infinite;
  box-shadow: 0 8px 32px rgba(26,41,128,0.14), 0 32px 64px rgba(26,41,128,0.12);
  border-radius: 22px;
}
.product-card-3d:hover .flip-inner { animation-play-state: paused; }
@keyframes autoRotate {
  0%, 38% { transform: rotateY(0deg); }
  50%, 88% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}
.flip-inner.flipped { transform: rotateY(180deg); animation: none; }
.flip-inner.unflipped { transform: rotateY(0deg); animation: none; }
.flip-face {
  position: absolute; inset: 0;
  backface-visibility: hidden;
  background: #fff;
  border-radius: 22px;
  border: 1.5px solid rgba(26,41,128,0.1);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.flip-back { transform: rotateY(180deg); }

@media (max-width: 900px) {
  #boardgame .reveal > div[style*="display:flex"] { flex-direction: column; }
  #boardgame .reveal > div[style*="display:flex"] > div[style*="padding:0 0 0 36px"] { padding: 28px 0 0 0 !important; }
}

/* COUPON */
.coupon {
  background:linear-gradient(135deg,#16a34a,#22c55e);
  color:#fff; border-radius:10px; padding:8px 16px;
  font-family:'Nunito',sans-serif; font-weight:800; font-size:0.82rem;
  display:inline-block; border:2px dashed rgba(255,255,255,0.55);
  box-shadow:0 4px 12px rgba(34,197,94,0.3);
}

/* REVEAL */
.reveal { opacity:0; transform:translateY(28px); transition:opacity 0.65s ease, transform 0.65s ease; }
.reveal.in { opacity:1; transform:none; }
.reveal-l { opacity:0; transform:translateX(-32px); transition:opacity 0.65s ease, transform 0.65s ease; }
.reveal-l.in { opacity:1; transform:none; }
.reveal-r { opacity:0; transform:translateX(32px); transition:opacity 0.65s ease, transform 0.65s ease; }
.reveal-r.in { opacity:1; transform:none; }

/* MOBILE MENU */
#mob { max-height:0; overflow:hidden; transition:max-height 0.4s ease; }
#mob.open { max-height:480px; }

/* GALLERY ITEMS */
.gal-item { border-radius:16px; overflow:hidden; }
.gal-item img { width:100%; height:100%; object-fit:cover; display:block; transition:transform 0.4s; }
.gal-item:hover img { transform:scale(1.06); }
.gal-placeholder {
  width:100%; height:100%; display:flex; flex-direction:column;
  align-items:center; justify-content:center; gap:8px; border-radius:16px;
}

/* GALLERY FOLDERS */
.gal-folder {
  background:linear-gradient(160deg,#ffffff,#eef6ff);
  border:2px solid #e8f0fe; border-radius:20px;
  padding:44px 24px 32px; text-align:center; cursor:pointer;
  transition:transform 0.25s cubic-bezier(.34,1.56,.64,1), box-shadow 0.25s, border-color 0.25s;
  box-shadow:0 4px 16px rgba(26,41,128,0.06);
}
.gal-folder:hover { transform:translateY(-8px); box-shadow:0 16px 34px rgba(26,41,128,0.16); border-color:#93c5fd; }
.gal-folder-icon { font-size:3.2rem; margin-bottom:14px; filter:drop-shadow(0 4px 8px rgba(26,41,128,0.15)); }
.gal-folder-title { font-family:'Nunito',sans-serif; font-weight:900; color:#1a2980; font-size:1.05rem; margin-bottom:6px; }
.gal-folder-count { color:#0ea5e9; font-family:'Nunito',sans-serif; font-weight:800; font-size:0.8rem; letter-spacing:0.04em; text-transform:uppercase; }

/* ALBUM MODAL */
.album-overlay {
  display:none; position:fixed; inset:0; z-index:2500;
  background:rgba(15,23,42,0.78); backdrop-filter:blur(4px);
  align-items:flex-start; justify-content:center;
  padding:56px 20px; overflow-y:auto;
}
.album-overlay.open { display:flex; }
.album-modal {
  background:#fff; border-radius:24px; max-width:1100px; width:100%;
  padding:32px; position:relative; margin-bottom:40px;
  box-shadow:0 30px 80px rgba(0,0,0,0.4);
}
.album-modal-header { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:4px; }
.album-modal-header h3 { font-family:'Nunito',sans-serif; font-weight:900; color:#1a2980; font-size:1.3rem; }
.album-close-btn {
  width:38px; height:38px; min-width:38px; border-radius:50%; border:none; background:#f0f7ff; color:#1a2980;
  font-size:1.05rem; cursor:pointer; display:flex; align-items:center; justify-content:center;
  transition:background 0.2s, transform 0.2s;
}
.album-close-btn:hover { background:#dbeafe; transform:scale(1.08); }
.album-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:16px; }

/* GALLERY ADMIN */
.manage-gallery-link {
  text-align:center; margin-top:22px; color:#94a3b8; font-family:'Nunito',sans-serif;
  font-weight:700; font-size:0.82rem; cursor:pointer; letter-spacing:0.02em;
  transition:color 0.2s;
}
.manage-gallery-link:hover { color:#1a2980; text-decoration:underline; }

.gal-del-btn {
  position:absolute; top:8px; right:8px; width:30px; height:30px; border-radius:50%;
  background:rgba(220,38,38,0.92); color:#fff; border:none; font-size:0.95rem; cursor:pointer;
  display:flex; align-items:center; justify-content:center; box-shadow:0 2px 8px rgba(0,0,0,0.3);
  transition:transform 0.15s, background 0.15s; z-index:5;
}
.gal-del-btn:hover { background:#b91c1c; transform:scale(1.1); }

.gal-add-tile {
  height:220px; border-radius:16px; border:2.5px dashed #93c5fd; background:#f0f7ff;
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px;
  cursor:pointer; color:#1a2980; transition:background 0.2s, border-color 0.2s;
}
.gal-add-tile:hover { background:#dbeafe; border-color:#1a2980; }

.admin-bar {
  display:none; position:fixed; bottom:0; left:0; right:0; z-index:2600;
  background:#1a2980; color:#fff; padding:12px 20px; align-items:center; justify-content:center;
  gap:16px; flex-wrap:wrap; font-family:'Nunito',sans-serif; font-weight:700; font-size:0.85rem;
  box-shadow:0 -4px 16px rgba(0,0,0,0.2);
}
.admin-bar.visible { display:flex; }
.admin-bar button {
  background:#0ea5e9; color:#fff; border:none; padding:8px 16px; border-radius:10px;
  font-family:'Nunito',sans-serif; font-weight:800; font-size:0.82rem; cursor:pointer;
  transition:background 0.2s;
}
.admin-bar button:hover { background:#0284c7; }
.admin-bar button:last-child { background:transparent; border:1.5px solid rgba(255,255,255,0.5); }
.admin-bar button:last-child:hover { background:rgba(255,255,255,0.12); }

.pw-overlay {
  display:none; position:fixed; inset:0; z-index:3200; background:rgba(15,23,42,0.78);
  backdrop-filter:blur(4px); align-items:center; justify-content:center; padding:20px;
}
.pw-overlay.open { display:flex; }
.pw-modal {
  background:#fff; border-radius:20px; padding:32px; max-width:360px; width:100%;
  box-shadow:0 30px 80px rgba(0,0,0,0.4); text-align:center;
}
.pw-modal h3 { font-family:'Nunito',sans-serif; font-weight:900; color:#1a2980; font-size:1.2rem; margin-bottom:8px; }
.pw-modal p { color:#64748b; font-size:0.88rem; margin-bottom:18px; }
.pw-modal input {
  width:100%; padding:12px 14px; border-radius:12px; border:1.5px solid #e2e8f0;
  font-size:1rem; margin-bottom:8px; box-sizing:border-box; text-align:center; letter-spacing:0.1em;
}
.pw-modal input:focus { outline:none; border-color:#1a2980; }
.pw-error { display:none; color:#dc2626; font-size:0.8rem; font-weight:700; margin-bottom:10px; }
.pw-error.show { display:block; }
.pw-actions { display:flex; gap:10px; margin-top:6px; }
.pw-actions button {
  padding:11px 0; border-radius:12px; font-family:'Nunito',sans-serif; font-weight:800;
  font-size:0.88rem; cursor:pointer; border:none; transition:opacity 0.2s;
}
.pw-actions button:hover { opacity:0.88; }
.btn-outline { background:#f0f7ff; color:#1a2980; }
.btn-blue { background:#1a2980; color:#fff; }

@media (prefers-reduced-motion:reduce) { *,::before,::after { transition-duration:0s!important; animation-duration:0s!important; } }
</style>
