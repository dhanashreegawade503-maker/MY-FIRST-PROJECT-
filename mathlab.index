<!-- FLOATING CONTACT BUTTONS -->
<div class="float-wrap">
  <button class="float-btn float-call" onclick="window.location.href='tel:8928703606'" title="Call Us" aria-label="Call">
    <svg width="24" height="24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.07 12 19.79 19.79 0 0 1 1 3.18 2 2 0 0 1 2.97 1h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91A16 16 0 0 0 13 14.87l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 21 16.92z"></path>
    </svg>
  </button>
  <button class="float-btn float-wa" onclick="window.open('https://wa.me/918928703606','_blank')" title="WhatsApp" aria-label="WhatsApp">
    <svg width="26" height="26" viewBox="0 0 32 32" fill="#fff">
      <path d="M16 2C8.268 2 2 8.268 2 16c0 2.45.655 4.746 1.797 6.734L2 30l7.5-1.766A13.94 13.94 0 0 0 16 30c7.732 0 14-6.268 14-14S23.732 2 16 2zm0 2c6.617 0 12 5.383 12 12s-5.383 12-12 12a11.94 11.94 0 0 1-6.105-1.674l-.424-.25-4.45 1.047 1.074-4.344-.276-.44A11.937 11.937 0 0 1 4 16C4 9.383 9.383 4 16 4zm-3.58 5.5c-.24 0-.63.09-.96.44-.33.35-1.27 1.24-1.27 3.02s1.3 3.5 1.48 3.74c.18.24 2.53 4.05 6.22 5.52.87.37 1.55.59 2.08.76.87.28 1.67.24 2.29.14.7-.11 2.15-.88 2.45-1.73.31-.84.31-1.57.22-1.73-.09-.15-.33-.24-.7-.42-.36-.18-2.15-1.06-2.49-1.18-.33-.12-.57-.18-.81.18-.24.36-.93 1.18-1.14 1.42-.21.24-.42.27-.78.09-.36-.18-1.52-.56-2.9-1.79-1.07-.96-1.8-2.14-2.01-2.5-.21-.36-.02-.55.16-.73.16-.16.36-.42.54-.63.18-.21.24-.36.36-.6.12-.24.06-.45-.03-.63-.09-.18-.81-1.95-1.11-2.67-.29-.7-.59-.6-.81-.61-.21-.01-.45-.01-.69-.01z"></path>
    </svg>
  </button>
</div>

<!-- NAVBAR -->
<nav id="navbar" class="scrolled">
  <div style="max-width:1200px;margin:0 auto;padding:10px 24px;display:flex;align-items:center;justify-content:space-between;">
    <a href="#home" style="display:flex;align-items:center;gap:10px;text-decoration:none;">
      <img src="data:image/jpeg;base64," alt="Logo" style="width:48px;height:48px;object-fit:contain;border-radius:8px;">
      <div>
        <div class="logo-font" style="font-size:1.5rem;color:#1a2980;line-height:1.1;">Mathematic's Laβ</div>
        <div style="font-size:0.5rem;font-weight:700;letter-spacing:0.18em;color:#0ea5e9;font-family:'Poppins',sans-serif;">EXPLORE · INFINITE · WORLD · OF · MATHEMATICS</div>
      </div>
    </a>
    <div style="display:none;" id="desk-nav" class="desk-nav-items">
      <a href="#home" class="nav-link">Home</a>
      <a href="#about" class="nav-link">About</a>
      <a href="#boardgame" class="nav-link">Board Game</a>
      <a href="#carnival" class="nav-link">Carnival</a>
      <a href="#minigame" class="nav-link">Mini-Game</a>
      <a href="#gallery" class="nav-link">Gallery</a>
      <a href="#reviews" class="nav-link">Reviews</a>
      <a href="#faq" class="nav-link">FAQ</a>
      <a href="#enquiry" class="btn-blue" style="padding:0.6rem 1.4rem;font-size:0.82rem;">Enquire Now</a>
    </div>
    <button id="ham" onclick="document.getElementById('mob').classList.toggle('open')" style="background:none;border:none;cursor:pointer;color:#1a2980;">
      <svg width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path></svg>
    </button>
  </div>
  <div id="mob" style="background:#fff;border-top:1px solid #e2e8f0;">
    <div style="max-width:1200px;margin:0 auto;padding:12px 24px;display:flex;flex-direction:column;gap:4px;">
      <a href="#home" onclick="closeMob()" style="display:block;padding:10px 12px;border-radius:10px;color:#1a2980;font-family:'Nunito',sans-serif;font-weight:700;text-decoration:none;">Home</a>
      <a href="#about" onclick="closeMob()" style="display:block;padding:10px 12px;border-radius:10px;color:#1a2980;font-family:'Nunito',sans-serif;font-weight:700;text-decoration:none;">About</a>
      <a href="#boardgame" onclick="closeMob()" style="display:block;padding:10px 12px;border-radius:10px;color:#1a2980;font-family:'Nunito',sans-serif;font-weight:700;text-decoration:none;">Board Game</a>
      <a href="#carnival" onclick="closeMob()" style="display:block;padding:10px 12px;border-radius:10px;color:#1a2980;font-family:'Nunito',sans-serif;font-weight:700;text-decoration:none;">Carnival</a>
      <a href="#minigame" onclick="closeMob()" style="display:block;padding:10px 12px;border-radius:10px;color:#1a2980;font-family:'Nunito',sans-serif;font-weight:700;text-decoration:none;">Mini-Game</a>
      <a href="#gallery" onclick="closeMob()" style="display:block;padding:10px 12px;border-radius:10px;color:#1a2980;font-family:'Nunito',sans-serif;font-weight:700;text-decoration:none;">Gallery</a>
      <a href="#reviews" onclick="closeMob()" style="display:block;padding:10px 12px;border-radius:10px;color:#1a2980;font-family:'Nunito',sans-serif;font-weight:700;text-decoration:none;">Reviews</a>
      <a href="#faq" onclick="closeMob()" style="display:block;padding:10px 12px;border-radius:10px;color:#1a2980;font-family:'Nunito',sans-serif;font-weight:700;text-decoration:none;">FAQ</a>
      <a href="#enquiry" onclick="closeMob()" class="btn-blue" style="text-align:center;margin-top:6px;">Enquire Now</a>
    </div>
  </div>
</nav>

<style>
@media(min-width:1024px){
  #desk-nav { display:flex!important; align-items:center; gap:22px; }
  #ham { display:none; }
}
</style>

<!-- HERO -->
<section id="home" class="hero" style="min-height:100vh;display:flex;align-items:center;padding:100px 24px 80px;position:relative;">
  <div style="max-width:1200px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr;gap:48px;align-items:center;">
    <div class="reveal in" style="color:#fff;">
      <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.15);border-radius:50px;padding:8px 18px;margin-bottom:24px;font-size:0.75rem;font-weight:700;letter-spacing:0.15em;backdrop-filter:blur(10px);">
        <span style="width:8px;height:8px;border-radius:50%;background:#26d0ce;display:inline-block;animation:pulse 1.5s ease-in-out infinite;"></span>
        TUITION CENTRE · EST. 2019
      </div>
      <style>@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.3}}</style>
      <div class="logo-font" style="font-size:clamp(2.5rem,6vw,4.5rem);line-height:1.1;margin-bottom:10px;text-shadow:0 4px 20px rgba(0,0,0,0.2);">Mathematic's Laβ</div>
      <div style="font-size:0.85rem;font-weight:700;letter-spacing:0.22em;color:#a5f3fc;margin-bottom:20px;font-family:'Poppins',sans-serif;">EXPLORE · INFINITE · WORLD · OF · MATHEMATICS</div>
      <p style="color:#bfdbfe;font-size:1.05rem;line-height:1.7;margin-bottom:32px;max-width:520px;">Where numbers spark curiosity, games build confidence, and every child discovers the real joy of mathematical thinking.</p>
      <div style="display:flex;flex-wrap:wrap;gap:14px;">
        <a href="#about" class="btn-blue" style="background:linear-gradient(135deg,#fff,#e0f2fe);color:#1a2980;box-shadow:0 4px 20px rgba(255,255,255,0.25);">Explore the Lab →</a>
        <a href="#minigame" style="border:2.5px solid rgba(255,255,255,0.6);color:#fff;font-family:'Nunito',sans-serif;font-weight:700;border-radius:50px;padding:0.8rem 2rem;display:inline-block;transition:all 0.2s;text-decoration:none;" onmouseover="this.style.background='rgba(255,255,255,0.15)'" onmouseout="this.style.background='transparent'">Play a Game 🎮</a>
        <a href="tel:8928703606" class="btn-green">📞 Call Now</a>
      </div>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:44px;max-width:540px;">
        <div style="background:rgba(255,255,255,0.12);border-radius:16px;padding:16px 6px;text-align:center;backdrop-filter:blur(10px);">
          <div class="logo-font" style="font-size:1.8rem;color:#fff;">500+</div>
          <div style="color:#a5f3fc;font-size:0.65rem;font-weight:600;margin-top:2px;font-family:'Poppins',sans-serif;">Students</div>
        </div>
        <div style="background:rgba(255,255,255,0.12);border-radius:16px;padding:16px 6px;text-align:center;backdrop-filter:blur(10px);">
          <div class="logo-font" style="font-size:1.8rem;color:#fff;">6+</div>
          <div style="color:#a5f3fc;font-size:0.65rem;font-weight:600;margin-top:2px;font-family:'Poppins',sans-serif;">Years</div>
        </div>
        <div style="background:rgba(255,255,255,0.12);border-radius:16px;padding:16px 6px;text-align:center;backdrop-filter:blur(10px);">
          <div class="logo-font" style="font-size:1.8rem;color:#fff;">98%</div>
          <div style="color:#a5f3fc;font-size:0.65rem;font-weight:600;margin-top:2px;font-family:'Poppins',sans-serif;">Satisfaction</div>
        </div>
        <div style="background:rgba(255,255,255,0.16);border:1px solid rgba(255,255,255,0.25);border-radius:16px;padding:16px 6px;text-align:center;backdrop-filter:blur(10px);">
          <div class="logo-font" style="font-size:1.8rem;color:#26d0ce;">90+</div>
          <div style="color:#a5f3fc;font-size:0.62rem;font-weight:600;margin-top:2px;font-family:'Poppins',sans-serif;line-height:1.3;">Games Created<br><span style="color:#fff;font-weight:700;">40+ Used in Class</span></div>
        </div>
      </div>
    </div>
    <div class="reveal-r in" style="display:flex;justify-content:center;">
      <img src="data:image/jpeg;base64," alt="Mathematic's Lab" style="width:100%;max-width:480px;border-radius:24px;box-shadow:0 20px 60px rgba(0,0,0,0.3);border:3px solid rgba(255,255,255,0.2);">
    </div>
  </div>
  <div class="hero-wave">
    <svg viewBox="0 0 1440 70" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0 35 C360 70 1080 0 1440 35 L1440 70 L0 70 Z" fill="#ffffff"></path></svg>
  </div>
</section>

<style>
@media(min-width:768px){
  #home > div > div { grid-template-columns:1fr 1fr!important; }
}
</style>

<!-- ABOUT -->
<section id="about" style="padding:96px 24px;background:#fff;">
  <div style="max-width:1200px;margin:0 auto;">
    <div class="reveal in" style="text-align:center;margin-bottom:56px;">
      <div class="eyebrow" style="margin-bottom:10px;">Why Choose Us</div>
      <h2 class="sec-title" style="font-size:clamp(2rem,4vw,2.8rem);margin-bottom:14px;">Built for <span>Curious Minds</span></h2>
      <p style="color:#64748b;max-width:520px;margin:0 auto;line-height:1.7;">We blend rigorous academics with play-based learning to make mathematics the subject every child looks forward to.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:28px;">
      <div class="card reveal in" style="padding:32px 28px;text-align:center;">
        <div style="width:64px;height:64px;border-radius:20px;background:linear-gradient(135deg,#dbeafe,#bfdbfe);display:flex;align-items:center;justify-content:center;font-size:2rem;margin:0 auto 20px;">🧠</div>
